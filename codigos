#include <stdio.h>

int main()
{
    int soma = 0;
    int contador_pares = 0;
    int i;

    for (i = 1; i <= 100; i++) {
        if (i % 2 == 0) {
            soma += i;
            contador_pares++;
        }
    }

    float media = (float)soma / contador_pares;

    printf("Quantidade de numeros pares: %d\n", contador_pares);
    printf("Soma dos numeros pares: %d\n", soma);
